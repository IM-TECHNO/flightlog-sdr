# flightlog-sdr backend settings. Copy this file to `.env` (same folder) and edit.
# `.env` is git-ignored. Real environment variables override anything set here.

# --- where the aircraft data comes from ----------------------------------------------------------
# SBS-1 (BaseStation) output of dump1090 / readsb. dump1090 --net serves it on port 30003.
SBS_HOST=127.0.0.1
SBS_PORT=30003

# --- your receiver -----------------------------------------------------------------------------------
# Antenna position in decimal degrees. Sets the map's home view and the range rings, and enables the
# coverage plot and "farthest catch". Leave at 0 to switch those off.
RECEIVER_LAT=0
RECEIVER_LON=0

# --- storage -------------------------------------------------------------------------------------------
DB_URL=sqlite+aiosqlite:///./flightlog.db
# Thin positions older than this many days to one per THIN_KEEP_SECONDS, once a day (0 = keep everything).
RETENTION_DAYS=0
THIN_KEEP_SECONDS=10
# Silence longer than this (seconds) ends a flight; a callsign change also starts a new one.
FLIGHT_GAP_SECONDS=1200

# --- signal strength -------------------------------------------------------------------------------
# The decoder's web feed, which carries the received signal level (RSSI). Empty = no signal data.
# dump1090 (Windows): http://127.0.0.1:8080/data/aircraft.json   readsb: http://127.0.0.1:8080/data/aircraft.json
AIRCRAFT_JSON_URL=http://127.0.0.1:8080/data/aircraft.json

# --- online lookups (off by default) ---------------------------------------------------------------
# 1 = look up aircraft type/registration and routes (adsbdb.com) and photos (planespotters.net).
# This sends the callsigns and ICAO24 addresses of the aircraft you receive to those services.
ENRICH_ONLINE=0

# --- airport activity (off until a position is set) -----------------------------------------------
# Arrivals, departures, runway use and go-arounds for one airport near your receiver.
# Example (Coimbatore):
#   AIRPORT_ICAO=VOCB
#   AIRPORT_NAME=Coimbatore
#   AIRPORT_LAT=11.03
#   AIRPORT_LON=77.0434
#   AIRPORT_ELEV_FT=1324
#   AIRPORT_RUNWAYS=05:49,23:229
AIRPORT_ICAO=
AIRPORT_NAME=
AIRPORT_LAT=0
AIRPORT_LON=0
AIRPORT_ELEV_FT=0
AIRPORT_RUNWAYS=

# --- receiver gain control (the "Rx" tab) --------------------------------------------------------------
# Lets the app edit dump1090.cfg and restart dump1090. Only the machine running the backend may use it.
RECEIVER_CONTROL=1
# Path to dump1090.cfg. Found automatically from the running Windows dump1090 when left empty.
DUMP1090_CFG=

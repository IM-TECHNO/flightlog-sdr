# flightlog-sdr frontend settings (Next.js reads `.env.local`; copy this file to `.env.local`).
#
# Address of the backend API. Leave unset and the app talks to the same host it was opened from, on
# port 8000, which is what you want for `localhost` and for opening it from a phone on your network.
# You can also override it per visit with ?api=http://host:8000 in the page address.
# NEXT_PUBLIC_API_URL=http://localhost:8000
